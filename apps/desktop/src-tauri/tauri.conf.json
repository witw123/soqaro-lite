{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soqaro Lite",
  "version": "1.0.0",
  "identifier": "top.witw.soqaro.lite",
  "build": {
    "beforeDevCommand": "pnpm --filter @soqaro/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @soqaro/web build",
    "frontendDist": "../../web/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Soqaro Lite",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "05F74BEF-402D-4CF5-804A-164C432C55D4"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/witw123/soqaro-lite/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOEVFOTA1MUQ5NjEwOTEKUldTUkVKWWRCZW1PWUV0aXVKamFXTDZzSEM4NENVUXhwNEpZZ2RXWXNJdlJtWnNKRXEvV3pBQXkK"
    }
  }
}
