{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Soqaro Lite desktop application",
  "windows": ["main", "lyrics"],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "sql:default",
    "shell:default",
    "shell:allow-open",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "fs:default",
    "dialog:default",
    "global-shortcut:default",
    "updater:default",
    "process:allow-restart",
    "allow-desktop-lyrics",
    "allow-app-management",
    "allow-system-media",
    "allow-native-download"
  ]
}
