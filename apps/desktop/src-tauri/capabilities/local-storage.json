{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-storage",
  "description": "Fixed repository access for the main Soqaro Lite window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://soqaro.witw.top",
      "https://soqaro.witw.top/*",
      "http://localhost:*",
      "http://localhost:*/*",
      "tauri://localhost",
      "tauri://localhost/*"
    ]
  },
  "permissions": [
    "allow-local-storage"
  ],
  "local": true
}