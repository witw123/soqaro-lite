{
  "name": "soqaro-lite",
  "version": "1.0.0",
  "private": true,
  "description": "点对点多人音频同步收听应用",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
